// 檢查每個專案現有的自動稅務預留，是否就是 lib/finance/calc.ts 規則算出來的結果（不需任何調整）。
// 資料庫端由 finance_sync_tax_reserve（0013_finance_rules.sql）維護，這支用 TypeScript 版本獨立核對兩邊一致。
// 只讀不寫；已軟刪除的列（預留與收支）一律不算。用法：DATABASE_URL=... node scripts/check-tax-reserves.mts
import pg from "pg";
import { taxReservesForShow, TAX_RESERVE_CATEGORY, type Tx } from "../lib/finance/calc.ts";
import { planReserveSync } from "../lib/finance/reserve.ts";
const c = new pg.Client({ connectionString: process.env.DATABASE_URL }); await c.connect();
const { rows } = await c.query(`select t.*, t.amount::float8 as amt, to_char(t.date,'YYYY-MM-DD') as d, s.name as show_name from transactions t join shows s on s.id=t.show_id where t.deleted_at is null`);
const byShow = new Map<string, Tx[]>();
for (const r of rows) byShow.set(r.show_name, [...(byShow.get(r.show_name) ?? []), { id: r.id, showName: r.show_name, category: r.category, notes: r.notes, amount: r.amt, advancedBy: r.advanced_by, excludedMembers: r.excluded_members, date: r.d, recordedBy: r.recorded_by, paidByFund: r.paid_by_fund, autoGenerated: r.auto_generated, sortOrder: Number(r.sort_order) }]);
let bad = 0;
for (const [name, txs] of byShow) {
  const existing = txs.filter((t) => t.autoGenerated && t.category === TAX_RESERVE_CATEGORY).map((t) => ({ id: t.id, excludedMembers: t.excludedMembers, amount: t.amount, date: t.date }));
  const plan = planReserveSync(existing, taxReservesForShow(name, txs));
  if (plan.inserts.length || plan.updates.length || plan.removes.length) { bad++; console.log("需要調整：", name, JSON.stringify(plan)); }
}
console.log(`檢查 ${byShow.size} 個專案，${bad} 個與現行規則的稅務預留不同`);
await c.end(); process.exit(bad ? 1 : 0);
