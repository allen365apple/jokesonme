# 看我笑話平台的環境變數範本。複製成 platform/.env.local 再填值（.env.local 不會進 git）。
# 協作者一律填「開發用」Supabase 專案的值，絕對不要填正式環境的金鑰。
# 等號後面直接貼值，不要加引號或空格。

# --- 開發環境標記（只有開發用的 .env.local 才填）---
# 標示這份金鑰是開發用的；種子資料腳本與假帳號登入都要看到這個值才會動作。
JK_ENV=
# 填 1 開啟本機假帳號登入 /api/dev/login?as=dev-member（正式環境永遠不會開）。
DEV_LOGIN=

# --- Supabase（開發用專案：Project Settings → API Keys / Database）---
# 專案網址，例如 https://xxxx.supabase.co
SUPABASE_URL=
# secret key（只給伺服器用，不要貼到任何網頁或聊天）
SUPABASE_SECRET_KEY=
# 資料庫連線字串，給 npm run db:migrate 與 npm run db:seed-dev 用
SUPABASE_DB_URL=

# --- 平台自己用的隨機金鑰（開發時自己產生一組，例如 openssl rand -hex 32）---
# 簽登入 session 用
AUTH_SECRET=
# 排程工作的密碼
CRON_SECRET=

# --- 網站網址（本機開發可留空）---
APP_URL=

# --- LINE（本機用假帳號登入就不需要；要測 LINE 登入或機器人才填開發用頻道）---
# Messaging API 頻道（機器人）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login 頻道（網站登入）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LIFF 小網頁 ID
LIFF_ID=

# --- 其他 ---
# 演出公開日曆的 iCal 網址（不是機密；行事曆頁會讀）
SHOW_CALENDAR_ICS_URL=
# 只有一次性搬家腳本用，平常不用填
DATABASE_URL=
